pragma solidity 0.8.26;

// Differential harness: replays cases generated by test/differential.test.ts against the
// real ContinuousClearingAuction and writes the outcomes back as JSON. Copied into an
// upstream checkout's test/ directory by that test; not compiled as part of this package.

import {Test} from 'forge-std/Test.sol';
import {ContinuousClearingAuction} from '../src/ContinuousClearingAuction.sol';
import {AuctionParameters} from '../src/interfaces/IContinuousClearingAuction.sol';
import {Checkpoint} from '../src/libraries/CheckpointLib.sol';
import {Bid} from '../src/libraries/BidLib.sol';
import {MockToken} from './utils/MockToken.sol';

contract DiffTest is Test {
    function test_differential() public {
        vm.pauseGasMetering();
        string memory inDir = vm.envString('CCA_DIFF_IN');
        uint256 n = vm.envUint('CCA_DIFF_CASES');
        for (uint256 i = 0; i < n; i++) {
            string memory path = string.concat(inDir, '/case-', vm.toString(i), '.json');
            _runCase(vm.readFile(path), string.concat(inDir, '/out-', vm.toString(i), '.json'));
        }
    }

    function _runCase(string memory json, string memory outPath) internal {
        ContinuousClearingAuction auction = _deploy(json);
        uint256[] memory blocks = vm.parseJsonUintArray(json, '.blocks');
        (uint256[] memory accepted, uint256[] memory ids) = _submitAll(auction, json, blocks);
        vm.roll(vm.parseJsonUint(json, '.endBlock') + 1);
        Checkpoint memory fin = auction.checkpoint();
        (uint256[] memory tokens, uint256[] memory refunds) = _exitAll(auction, fin, accepted, ids);
        string memory k = 'out';
        vm.serializeUint(k, 'finalClearingPrice', fin.clearingPrice);
        vm.serializeUint(k, 'currencyRaised', auction.currencyRaised());
        vm.serializeBool(k, 'graduated', auction.isGraduated());
        vm.serializeUint(k, 'accepted', accepted);
        vm.serializeUint(k, 'tokensFilled', tokens);
        string memory out = vm.serializeUint(k, 'refunds', refunds);
        vm.writeJson(out, outPath);
    }

    function _deploy(string memory json) internal returns (ContinuousClearingAuction auction) {
        uint256 startBlock = vm.parseJsonUint(json, '.startBlock');
        uint256 endBlock = vm.parseJsonUint(json, '.endBlock');
        AuctionParameters memory params = AuctionParameters({
            currency: address(0),
            tokensRecipient: address(0xA1),
            fundsRecipient: address(0xA2),
            startBlock: uint64(startBlock),
            endBlock: uint64(endBlock),
            claimBlock: uint64(endBlock),
            tickSpacing: vm.parseJsonUint(json, '.tickSpacing'),
            validationHook: address(0),
            floorPrice: vm.parseJsonUint(json, '.floorPrice'),
            requiredCurrencyRaised: uint128(vm.parseJsonUint(json, '.requiredCurrencyRaised')),
            auctionStepsData: vm.parseJsonBytes(json, '.steps')
        });
        uint128 totalSupply = uint128(vm.parseJsonUint(json, '.totalSupply'));
        vm.roll(startBlock - 10);
        MockToken token = new MockToken();
        auction = new ContinuousClearingAuction(address(token), totalSupply, params, address(0));
        token.mint(address(auction), totalSupply);
        auction.onTokensReceived();
    }

    function _submitAll(ContinuousClearingAuction auction, string memory json, uint256[] memory blocks)
        internal
        returns (uint256[] memory accepted, uint256[] memory ids)
    {
        uint256[] memory prices = vm.parseJsonUintArray(json, '.prices');
        uint256[] memory amounts = vm.parseJsonUintArray(json, '.amounts');
        accepted = new uint256[](blocks.length);
        ids = new uint256[](blocks.length);
        for (uint256 j = 0; j < blocks.length; j++) {
            if (block.number != blocks[j]) vm.roll(blocks[j]);
            address owner = address(uint160(0x10000 + j));
            vm.deal(owner, amounts[j]);
            vm.prank(owner);
            try auction.submitBid{value: amounts[j]}(prices[j], uint128(amounts[j]), owner, bytes('')) returns (
                uint256 id
            ) {
                accepted[j] = 1;
                ids[j] = id;
            } catch {}
        }
    }

    function _exitAll(
        ContinuousClearingAuction auction,
        Checkpoint memory fin,
        uint256[] memory accepted,
        uint256[] memory ids
    ) internal returns (uint256[] memory tokens, uint256[] memory refunds) {
        tokens = new uint256[](accepted.length);
        refunds = new uint256[](accepted.length);
        bool graduated = auction.isGraduated();
        for (uint256 j = 0; j < accepted.length; j++) {
            if (accepted[j] == 0) continue;
            address owner = address(uint160(0x10000 + j));
            uint256 before = owner.balance;
            _exitOne(auction, ids[j], graduated, fin.clearingPrice);
            tokens[j] = auction.bids(ids[j]).tokensFilled;
            refunds[j] = owner.balance - before;
        }
    }

    function _exitOne(ContinuousClearingAuction auction, uint256 id, bool graduated, uint256 finalClearing) internal {
        Bid memory bid = auction.bids(id);
        if (!graduated || bid.maxPrice > finalClearing) {
            auction.exitBid(id);
        } else {
            (uint64 lastFull, uint64 outbid) = _hints(auction, bid);
            auction.exitPartiallyFilledBid(id, lastFull, outbid);
        }
    }

    /// Walk the checkpoint list from the bid's start to find exit hints.
    function _hints(ContinuousClearingAuction auction, Bid memory bid) internal view returns (uint64 lastFull, uint64 outbid) {
        uint64 b = bid.startBlock;
        lastFull = b;
        Checkpoint memory c = auction.checkpoints(b);
        while (c.next != type(uint64).max) {
            uint64 nb = c.next;
            Checkpoint memory nc = auction.checkpoints(nb);
            if (nc.clearingPrice < bid.maxPrice) lastFull = nb;
            if (nc.clearingPrice > bid.maxPrice) {
                outbid = nb;
                break;
            }
            c = nc;
        }
    }
}
