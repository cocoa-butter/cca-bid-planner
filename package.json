{
  "name": "cca-bid-planner",
  "version": "0.1.0",
  "description": "Read-only bid planner for Uniswap Continuous Clearing Auctions (CCA): bid schedules, fill simulation and risk checks. Never signs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cca-bid-planner": "dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "AUTHORS.md"
  ],
  "keywords": [
    "uniswap",
    "cca",
    "continuous-clearing-auction",
    "auction",
    "bid",
    "planner"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "abi:extract": "node scripts/extract-abi.mjs",
    "smoke": "node dist/cli/bin.js --help",
    "prepare": "npm run build",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "dev:site": "npm run build:site && npx --yes serve site-dist"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "marked": "18.1.3",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocoa-butter/cca-bid-planner.git"
  },
  "homepage": "https://github.com/cocoa-butter/cca-bid-planner#readme",
  "bugs": {
    "url": "https://github.com/cocoa-butter/cca-bid-planner/issues"
  },
  "author": "cocoa-butter"
}
